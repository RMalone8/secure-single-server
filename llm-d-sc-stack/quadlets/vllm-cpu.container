[Unit]
Description=vLLM CPU backend (Qwen2.5-1.5B-Instruct)
After=network-online.target
Wants=network-online.target

[Container]
Image=registry.redhat.io/rhaii/vllm-cpu-rhel9:3.5.1-1788368981
ContainerName=vllm-cpu
Network=llm-d-sc.network
PublishPort=127.0.0.1:8001:8080
SecurityLabelDisable=true
# ipc handled via PodmanArgs below
PodmanArgs=--ipc=host
UserNS=keep-id:uid=1001
Volume=%h/model-cache:/opt/app-root/src/.cache:Z
Volume=vllm-cpu-compile:/tmp/vllm
Environment=HF_HUB_OFFLINE=0
Environment=HUGGING_FACE_HUB_TOKEN=
Environment=VLLM_CPU_KVCACHE_SPACE=8
Environment=OMP_NUM_THREADS=6
Environment=VLLM_CPU_OMP_THREADS_BIND=0-5
Exec=--model Qwen/Qwen3-0.6B --host 0.0.0.0 --port 8080 --max-model-len 32768 --enable-auto-tool-choice --tool-call-parser hermes --reasoning-parser qwen3 --served-model-name Semantic-Qwen --enforce-eager

[Service]
Restart=on-failure
RestartSec=10s
TimeoutStartSec=1800
TimeoutStopSec=60

[Install]
WantedBy=default.target
